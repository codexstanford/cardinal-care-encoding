covered(C) :-
    claim.service_type(C, S) &
    tmj_cmj_service(S) &
    ~excluded_tmj_cmj_service(S).

tmj_cmj_service(diagnostic_therapeutic_service).
tmj_cmj_service(medical_surgical_service).
tmj_cmj_service(dental_surgical_service).
tmj_cmj_service(medical_non_surgical_service).
tmj_cmj_service(dental_non_surgical_service).

excluded_tmj_cmj_service(dental_implant_service).
