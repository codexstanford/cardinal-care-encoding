        "the service in $C$ is a TMJ/CMJ medical surgical service")

berlitz(claim.service_type(C, tmj_cmj_dental_surgical_service),
        "the service in $C$ is a TMJ/CMJ dental surgical service")

berlitz(claim.service_type(C, tmj_cmj_medical_non_surgical_service),
        "the service in $C$ is a TMJ/CMJ medical non-surgical service")

berlitz(claim.service_type(C, tmj_cmj_dental_non_surgical_service),
        "the service in $C$ is a TMJ/CMJ dental non-surgical service")

berlitz(claim.service_type(C, dental_implant_service),
        "the service in $C$ is a dental implant service")


