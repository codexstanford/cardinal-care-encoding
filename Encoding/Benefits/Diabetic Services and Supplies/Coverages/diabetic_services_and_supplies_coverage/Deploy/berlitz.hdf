%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%% Base Relations 
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% If you want a plain-English line for self_management_training_supervised_by_qualified_professional:
berlitz(claim.self_management_training_supervised_by_qualified_professional(C, yes),
        "the self-management training in $C$ was supervised by a qualified professional")
berlitz(claim.self_management_training_supervised_by_qualified_professional(C, no),
        "the self-management training in $C$ was not supervised by a qualified professional")

