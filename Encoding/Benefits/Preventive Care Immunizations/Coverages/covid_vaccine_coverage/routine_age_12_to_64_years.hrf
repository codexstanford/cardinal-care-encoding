
%%% Unvaccinated
allowed_one_more_updated_2024_2025_covid19_vaccine_with_brand(no, 12_to_64_years, Brand, Claim) :-
    (
        mrna_vaccine(Brand) |
        same(Brand, novavax)
    ) &
    claim.covid19_vaccine_history(Claim, nil)

allowed_one_more_updated_2024_2025_covid19_vaccine_with_brand(no, 12_to_64_years, Brand, Claim) :-
    same(Brand, novavax) &
    num_old_vaccines_in_claim(Claim, 0) &
    num_updated_vaccines_in_claim(Claim, 1) &
    claim.covid19_vaccine_history(Claim, Vaccines) &
    num_updated_2024_2025_covid19_vaccines_with_brand(Vaccines, novavax, 1)

%%% Previously vaccinated before 2024-2025 vaccine
allowed_one_more_updated_2024_2025_covid19_vaccine_with_brand(no, 12_to_64_years, Brand, Claim) :-
    (
        mrna_vaccine(Brand) |
        same(Brand, novavax)
    ) &
    num_updated_vaccines_in_claim(Claim, 0) &
    claim.covid19_vaccine_history(Claim, Vaccines) &
    (
        (
            num_old_mrna_vaccines_in_claim(Claim, NumOldMrna) &
            leq(1, NumOldMrna)
        ) |
        (
            num_old_2024_2025_covid19_vaccines_with_brand(Vaccines, novavax, NumOldNovavax) &
            leq(2, NumOldNovavax)
        )
    )

allowed_one_more_updated_2024_2025_covid19_vaccine_with_brand(no, 12_to_64_years, Brand, Claim) :-
    same(Brand, novavax) &
    num_updated_vaccines_in_claim(Claim, 0) &
    claim.covid19_vaccine_history(Claim, Vaccines) &
    num_old_2024_2025_covid19_vaccines_with_brand(Vaccines, novavax, 1)