%%% Immunocompromised 12+ years (in the 65+ age bracket)
%%% Taking: moderna (pfizer_biontech available)
%%% History: 1 dose non-updated pfizer_biontech, 1 dose updated pfizer_biontech

%%% Types %%%
type(claim1, covid_vaccine_coverage)

%%% Claim %%%
%% Service-generic %%
claim.date_service_received(claim1,2024_08_30)
claim.patient_dob(claim1, 1924_08_30)

claim.location_service_received(claim1, stanford_health_care)
claim.service_available_at_tier_one_or_two_location(claim1, yes)

%% Service-specific %%
claim.reason_for_immunization(claim1, preventive_care)

% Covid vaccine-specific
claim.patient_is_immunocompromised(claim1, yes)
claim.covid19_vaccine_brand(claim1, moderna)
claim.covid19_vaccines_available_at_location(claim1, [moderna, novavax, pfizer_biontech])

claim.covid19_vaccine_history(claim1, [
    covid19_vaccination(pfizer_biontech, not_updated_2024_2025, 2024_08_01),
    covid19_vaccination(pfizer_biontech, updated_2024_2025, 2024_08_01)
])

